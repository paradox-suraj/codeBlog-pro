generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  role            Role             @default(READER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  bookmarks       Bookmark[]
  comments        Comment[]
  likes           Like[]           // These are now generic "Reactions"
  notifications   Notification[]
  posts           Post[]
  postViews       PostView[]
  profile         Profile?
  sessions        Session[]
  aiConversations AIConversation[]
  aiUsages        AIUsage[]
  series          Series[]
  
  // Follow System
  followers       Follows[]        @relation("Following")
  following       Follows[]        @relation("Follower")
  
  // Reading History
  readingProgress ReadingProgress[]

  @@index([email])
}

// Self-referencing many-to-many for user follows
model Follows {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  website    String?
  twitter    String?
  github     String?
  linkedin   String?
  avatar     String?
  location   String?
  skills     String[] // Tech stack
  experience String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      PostStatus   @default(DRAFT)
  featured    Boolean      @default(false)
  scheduledAt DateTime?
  readingTime Int?
  views       Int          @default(0)
  shares      Int          @default(0)
  authorId    String
  categoryId  String?
  seriesId    String?      // Connects to a Series
  seriesOrder Int?         // Position in the series
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       Like[]
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id])
  series      Series?      @relation(fields: [seriesId], references: [id])
  tags        PostTag[]
  postViews   PostView[]
  versions    PostVersion[]
  readingProgress ReadingProgress[]

  // AI Embedding for Smart Search / Related
  embedding   Unsupported("vector(768)")?

  @@index([slug])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([categoryId])
  @@index([seriesId])
  @@index([featured])
}

// Version History for Posts
model PostVersion {
  id        String   @id @default(cuid())
  postId    String
  title     String
  content   String
  excerpt   String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
}

// Article Series
model Series {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  author      User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([authorId])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  color       String?
  icon        String?
  posts       Post[]

  @@index([slug])
}

model Tag {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  color String?
  posts PostTag[]

  @@index([slug])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

enum ReactionType {
  LIKE
  USEFUL
  INSIGHTFUL
  HELPFUL
}

model Like {
  id        String       @id @default(cuid())
  userId    String
  postId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

// Bookmark Collections
model BookmarkCollection {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  bookmarks Bookmark[]

  @@index([userId])
}

model Bookmark {
  id           String              @id @default(cuid())
  userId       String
  postId       String
  collectionId String?
  createdAt    DateTime            @default(now())
  post         Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([collectionId])
}

// Reading History / Progress
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  progress  Int      @default(0) // Percentage 0-100
  completed Boolean  @default(false)
  lastRead  DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Newsletter {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  subscribedAt DateTime @default(now())
  confirmed    Boolean  @default(false)
  active       Boolean  @default(true)

  @@index([active])
}

model PostView {
  id       String   @id @default(cuid())
  postId   String
  userId   String?
  ipHash   String?
  viewedAt DateTime @default(now())
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([ipHash])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

enum Role {
  ADMIN
  AUTHOR
  READER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model AIConversation {
  id          String      @id @default(cuid())
  userId      String?
  contextType String?   // e.g., "GLOBAL", "POST", "ANALYTICS"
  contextId   String?   // e.g., postId
  title       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
  @@index([contextType, contextId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         // "user", "assistant", "system"
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIUsage {
  id          String   @id @default(cuid())
  userId      String?
  model       String
  requestType String   // "chat", "summary", "generation", "seo"
  tokens      Int      @default(0)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
