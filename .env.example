# =============================================================================
# CodeBlog Pro — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon Serverless Postgres)
# Get your connection string from: https://console.neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/database"
# Uncomment if using Prisma connection pooler (e.g., Prisma Accelerate)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION (Auth.js v5 / NextAuth)
# Generate secret: openssl rand -base64 32
# Docs: https://authjs.dev/reference/nextjs
# -----------------------------------------------------------------------------
AUTH_SECRET="your_generated_auth_secret_here"

# Application URL — change to production URL when deploying
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_id_here"
AUTH_GITHUB_SECRET="your_github_secret_here"

# Google OAuth App
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_id_here"
AUTH_GOOGLE_SECRET="your_google_secret_here"

# -----------------------------------------------------------------------------
# CLOUDINARY (Image Storage & CDN)
# Get credentials from: https://cloudinary.com/console
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"
# Upload preset must be created in Cloudinary dashboard
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_upload_preset_here"

# -----------------------------------------------------------------------------
# RESEND (Transactional Email for Newsletter)
# Get API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# -----------------------------------------------------------------------------
# APPLICATION CONFIG
# -----------------------------------------------------------------------------
# Public URL of your application (used for OG images, sitemap, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Site display name (used in metadata)
NEXT_PUBLIC_SITE_NAME="CodeBlog Pro"

# Admin email — this user gets auto-promoted to ADMIN role on first sign-in
ADMIN_EMAIL="your_admin_email@example.com"

# Secret key to protect the scheduled posts cron endpoint
# Generate: openssl rand -hex 32
CRON_SECRET="your_generated_cron_secret_here"

# -----------------------------------------------------------------------------
# UPSTASH REDIS (Optional — for rate limiting)
# Get credentials from: https://console.upstash.com
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"
